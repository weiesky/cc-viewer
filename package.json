{
  "name": "cc-viewer-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --filter @ccv/web dev",
    "build": "pnpm --filter @ccv/web build && pnpm --filter cc-viewer run assemble",
    "build:sourcemap": "pnpm --filter @ccv/web run build:sourcemap && pnpm --filter cc-viewer run assemble",
    "start": "node packages/app/server.js",
    "lint:control-bytes": "node scripts/check-no-control-bytes.js",
    "verify:wire-v2": "node packages/app/cli.js verify",
    "pretest": "pnpm run lint:control-bytes",
    "pretest:cli": "pnpm run lint:control-bytes",
    "pretest:coverage": "pnpm run lint:control-bytes",
    "pretest:coverage:html": "pnpm run lint:control-bytes",
    "test": "CCV_INSTANCE_ID= CCV_LOG_DIR=tmp CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 node --test --test-force-exit --test-timeout=120000",
    "test:cli": "CCV_TEST_CLI=1 CCV_INSTANCE_ID= CCV_LOG_DIR=tmp CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 node --test --test-force-exit --test-timeout=120000",
    "test:coverage": "CCV_TEST_CLI=1 CCV_INSTANCE_ID= CCV_LOG_DIR=tmp CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 node --test --test-force-exit --test-timeout=120000 --experimental-test-coverage --test-coverage-include='packages/app/server/**/*.js' --test-coverage-include='packages/app/src/utils/**/*.js' --test-coverage-include='packages/app/*.js'",
    "test:coverage:html": "CCV_TEST_CLI=1 CCV_INSTANCE_ID= CCV_LOG_DIR=tmp CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 c8 --reporter=text-summary --reporter=html node --test --test-force-exit --test-timeout=120000",
    "electron:dev": "pnpm --filter @ccv/electron run dev",
    "electron:build": "pnpm --filter @ccv/electron run build",
    "electron:sign": "pnpm --filter @ccv/electron run sign",
    "electron:check-sign": "pnpm --filter @ccv/electron run check-sign"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.91",
    "@changesets/cli": "^3.0.0",
    "@xterm/xterm": "^6.0.0",
    "adm-zip": "^0.5.17",
    "c8": "^11.0.0",
    "dingtalk-stream": "2.1.5",
    "marked": "^17.0.2",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "undici": "^7.22.0",
    "ws": "^8.21.0"
  },
  "c8": {
    "include": [
      "packages/app/server/**/*.js",
      "packages/app/src/utils/**/*.js",
      "packages/app/*.js"
    ],
    "exclude": [
      "test/**",
      "**/dist/**",
      "node_modules/**",
      "apps/**",
      "scripts/**",
      "coverage/**"
    ],
    "all": true,
    "report-dir": "coverage",
    "skip-full": false,
    "check-coverage": false
  }
}
