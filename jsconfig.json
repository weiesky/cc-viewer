{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "jsx": "preserve",
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "strictNullChecks": false
  },
  "include": [
    "apps/web/src/**/*",
    "apps/web/test/**/*",
    "apps/electron/electron/**/*",
    "apps/electron/test/**/*",
    "packages/app/**/*",
    "packages/core/**/*",
    "packages/content/test/**/*",
    "test/**/*",
    "scripts/**/*"
  ],
  "exclude": ["node_modules", "build", "dist"]
}
